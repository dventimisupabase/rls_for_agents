# Local stack values come from `supabase status`. The publishable key is public by design;
# never put a secret or service_role key in a VITE_ variable (it ships to the browser).
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Agent: "dev" = local dev agent (deno run -A --config evals/deno.json scripts/dev-agent.ts),
# "agentcore" = AgentCore Runtime (pack 03; not configured yet).
VITE_AGENT_MODE=dev
VITE_AGENT_URL=http://127.0.0.1:8787/invocations
# Level 2 (stretch): show "Send Kestrel a payment" on the brief. Presentation only: the database function exists
# wherever its migration is applied. Off unless set to 1.
VITE_LEVEL2=
