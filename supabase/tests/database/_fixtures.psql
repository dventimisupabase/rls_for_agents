-- Shared test fixture. Included by each *.test.sql with \ir. Runs inside the test's transaction.
create extension if not exists pgtap with schema extensions;

-- Persona switch, the same way PostgREST does it: role GUC + request.jwt.claims.
-- Call as postgres; return to postgres with `reset role;`.
create function pg_temp.act_as(p_sub uuid, p_client uuid default null) returns void
  language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    jsonb_strip_nulls(jsonb_build_object('sub', p_sub, 'role', 'authenticated', 'aud', 'authenticated',
                                         'client_id', p_client))::text, true);
  perform set_config('role', 'authenticated', true);
end $$;

